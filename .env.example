# Copy this file to ".env" in this folder and paste in your real Portkey API key.
# The real .env is git-ignored and must never be committed.
#
#   cp .env.example .env     (macOS/Linux)
#   copy .env.example .env   (Windows)
#
# The agent reads this key and talks to gpt-6-luna through Portkey.

PORTKEY_API_KEY=pk-your-portkey-api-key-here
